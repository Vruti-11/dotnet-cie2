@model IEnumerable<dotnet_cie2.Models.ExternalUser>

@{
    ViewData["Title"] = "Async User Directory";
    string? errorMessage = ViewBag.ErrorMessage;
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1"><i class="bi bi-cloud-arrow-down-fill text-primary me-2"></i> Asynchronous User Directory</h2>
        <p class="text-muted mb-0">Fetched asynchronously from <code>https://jsonplaceholder.typicode.com/users</code> via <code>HttpClient</code>.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="soft-badge soft-badge-info py-2 px-3">
            <i class="bi bi-arrow-repeat text-primary me-1"></i> Async Web Request
        </span>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="soft-card border-start border-4 border-danger p-4 mb-4">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-3"></i>
            <div>
                <h5 class="fw-bold mb-1">Error Fetching Remote Data</h5>
                <p class="mb-0 text-muted">@errorMessage</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="soft-table-wrapper">
        <table class="soft-table">
            <thead>
                <tr>
                    <th><i class="bi bi-hash me-1"></i> ID</th>
                    <th><i class="bi bi-person me-1"></i> Name</th>
                    <th><i class="bi bi-envelope me-1"></i> Email</th>
                    <th><i class="bi bi-building me-1"></i> Company</th>
                    <th><i class="bi bi-globe me-1"></i> Website</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <span class="soft-badge soft-badge-primary">#@user.Id</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="icon-box-soft" style="width: 36px; height: 36px; font-size: 0.9rem;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block">@user.Name</strong>
                                        <small class="text-muted">@@@user.Username</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@user.Email" class="text-decoration-none fw-medium text-dark">
                                    <i class="bi bi-envelope-at text-secondary me-1"></i> @user.Email
                                </a>
                            </td>
                            <td>
                                <div class="soft-badge soft-badge-info">
                                    <i class="bi bi-briefcase-fill me-1"></i>
                                    @(user.Company?.Name ?? "N/A")
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    <i class="bi bi-link-45deg me-1"></i> @user.Website
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i> No user records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
