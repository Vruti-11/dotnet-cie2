@using dotnet_cie2.Extensions
@model dotnet_cie2.Models.Course

@{
    ViewData["Title"] = $"Course Details - {Model.CourseName}";
    decimal finalFees = Model.CalculateFinalFees();
    decimal discountSaved = Model.GetDiscountAmount();
    int queryStringId = ViewBag.QueryStringCourseId ?? Model.CourseId;
    string renderTimestamp = ViewBag.RenderTimestamp ?? DateTime.Now.ToString("HH:mm:ss.fff");
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Navigation breadcrumb & caching status -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
            <a asp-controller="Course" asp-action="Index" class="btn btn-soft text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Catalog
            </a>
            <!-- Response Caching Indicator -->
            <div class="soft-card py-2 px-3">
                <small class="fw-bold text-muted me-2"><i class="bi bi-shield-check text-success"></i> Response Caching Active (300s):</small>
                <span class="soft-badge soft-badge-info">Render Time: @renderTimestamp</span>
            </div>
        </div>

        <!-- Main Course Details Soft Card -->
        <div class="soft-card mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box-soft" style="width: 60px; height: 60px; font-size: 1.8rem;">
                            <i class="bi @Model.Icon"></i>
                        </div>
                        <div>
                            <span class="soft-badge soft-badge-primary mb-1">@Model.Category</span>
                            <h2 class="fw-bold mb-0">@Model.CourseName</h2>
                        </div>
                    </div>

                    <p class="text-muted leading-relaxed mb-4">@Model.Description</p>

                    <!-- Technical Requirements Checklists -->
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="soft-inset">
                                <small class="text-muted d-block fw-bold mb-1">Course Identification</small>
                                <div class="d-flex justify-content-between">
                                    <span>Course ID:</span>
                                    <!-- Query String Demo -->
                                    <strong class="text-primary">@Model.CourseId (Passed via Query String)</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="soft-inset">
                                <small class="text-muted d-block fw-bold mb-1">Duration & Format</small>
                                <div class="d-flex justify-content-between">
                                    <span>Duration:</span>
                                    <strong>@Model.Duration</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Pricing Card with Extension Method Calculation -->
                    <div class="soft-card bg-light border border-primary-subtle text-center p-4">
                        <span class="text-muted small fw-bold uppercase d-block mb-1">Fee Breakdown</span>
                        <div class="mb-2">
                            <span class="original-price fs-5">$@Model.Fees.ToString("N2")</span>
                            <span class="discount-badge ms-2">-@Model.DiscountPercentage%</span>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted small d-block">Final Fees (Extension Method):</span>
                            <span class="final-price fs-1">$@finalFees.ToString("N2")</span>
                        </div>
                        <p class="text-success small fw-semibold mb-4">
                            <i class="bi bi-piggy-bank-fill me-1"></i> You save $@discountSaved.ToString("N2")!
                        </p>

                        <div class="d-grid gap-2">
                            <a asp-controller="Course" asp-action="Enroll" asp-route-courseId="@Model.CourseId" class="btn btn-soft-primary">
                                <i class="bi bi-pen-fill me-1"></i> Enroll in this Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Demonstration Highlights for Technical Reviewers -->
        <div class="soft-card bg-white border-0">
            <h5 class="fw-bold mb-3"><i class="bi bi-check2-circle text-primary me-2"></i> Requirement Compliance Verification</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="soft-inset">
                        <strong class="d-block text-primary"><i class="bi bi-code-slash me-1"></i> 1. Extension Method:</strong>
                        <code class="d-block mt-1">Model.CalculateFinalFees() = $@finalFees.ToString("N2")</code>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="soft-inset">
                        <strong class="d-block text-primary"><i class="bi bi-link-45deg me-1"></i> 2. Query String Parameter:</strong>
                        <code class="d-block mt-1">/Course/Details?id=@queryStringId</code>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="soft-inset">
                        <strong class="d-block text-primary"><i class="bi bi-hdd-network me-1"></i> 3. Session State:</strong>
                        <span class="d-block mt-1 text-muted">Stored Selected Course: <strong>@Model.CourseName</strong></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="soft-inset">
                        <strong class="d-block text-primary"><i class="bi bi-speedometer me-1"></i> 4. Response Caching:</strong>
                        <span class="d-block mt-1 text-muted">Cached for 300 seconds using <code>[ResponseCache]</code> attribute.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
